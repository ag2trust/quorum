#!/bin/sh
# pre-push — cheap mechanical gate on every push: branch-base check + cargo fmt.
#
# Installed by dev-install.sh via `git config core.hooksPath .githooks` (repo
# config is shared by all worktrees). The full gate — clippy + tests — is
# ./preflight.sh, required before `task-update --status done`; this hook only
# runs the fast subset so pushing stays quick while still catching the two most
# common review-round wasters: fmt drift and branching from a feature branch.
#
# Do NOT bypass with --no-verify — fix the underlying issue instead.

set -u

fail() {
  printf 'pre-push: %s\n' "$1" >&2
  exit 1
}

[ "$#" -eq 2 ] || fail "expected remote name and URL arguments"

# Git supplies one line per proposed ref update:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# Read at most two so the daemon's atomic cleanup transaction can be recognized
# without accepting arbitrary multi-ref publication.
LOCAL_REF_1=
LOCAL_SHA_1=
REMOTE_REF_1=
REMOTE_SHA_1=
EXTRA_1=
if ! read -r LOCAL_REF_1 LOCAL_SHA_1 REMOTE_REF_1 REMOTE_SHA_1 EXTRA_1; then
  [ -n "$LOCAL_REF_1$LOCAL_SHA_1$REMOTE_REF_1$REMOTE_SHA_1$EXTRA_1" ] \
    || fail "missing pre-push ref update"
fi
[ -z "$EXTRA_1" ] || fail "malformed pre-push ref update"

LOCAL_REF_2=
LOCAL_SHA_2=
REMOTE_REF_2=
REMOTE_SHA_2=
EXTRA_2=
HAS_SECOND=0
if read -r LOCAL_REF_2 LOCAL_SHA_2 REMOTE_REF_2 REMOTE_SHA_2 EXTRA_2; then
  HAS_SECOND=1
elif [ -n "$LOCAL_REF_2$LOCAL_SHA_2$REMOTE_REF_2$REMOTE_SHA_2$EXTRA_2" ]; then
  HAS_SECOND=1
fi
if [ "$HAS_SECOND" -eq 1 ]; then
  [ -z "$EXTRA_2" ] || fail "malformed pre-push ref update"
  THIRD_LINE=
  if IFS= read -r THIRD_LINE || [ -n "$THIRD_LINE" ]; then
    fail "too many ref updates"
  fi
fi

is_oid() {
  printf '%s\n' "$1" | grep -Eq '^([0-9a-f]{40}|[0-9a-f]{64})$'
}
is_zero_oid() {
  printf '%s\n' "$1" | grep -Eq '^(0{40}|0{64})$'
}

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

validate_update() {
  local_ref=$1
  local_sha=$2
  remote_ref=$3
  remote_sha=$4

  is_oid "$local_sha" || fail "malformed local SHA"
  is_oid "$remote_sha" || fail "malformed remote SHA"
  case "$remote_ref" in
    refs/*) ;;
    *) fail "malformed remote ref" ;;
  esac
  if ! is_zero_oid "$local_sha"; then
    mapped_sha=$(git rev-parse --verify "$local_ref" 2>/dev/null) \
      || fail "local ref does not resolve to an object"
    [ "$mapped_sha" = "$local_sha" ] \
      || fail "local ref does not map to local SHA"
  fi
}

is_cleanup_create() {
  ! is_zero_oid "$2" \
    && is_zero_oid "$4" \
    && case "$3" in refs/heads/quorum-cleanup/*) true ;; *) false ;; esac
}

is_cleanup_delete() {
  is_zero_oid "$2" \
    && ! is_zero_oid "$4" \
    && case "$3" in
      refs/heads/quorum-cleanup/*) false ;;
      refs/heads/*) true ;;
      *) false ;;
    esac
}

validate_update "$LOCAL_REF_1" "$LOCAL_SHA_1" "$REMOTE_REF_1" "$REMOTE_SHA_1"
if [ "$HAS_SECOND" -eq 1 ]; then
  validate_update "$LOCAL_REF_2" "$LOCAL_SHA_2" "$REMOTE_REF_2" "$REMOTE_SHA_2"

  # The only supported multi-ref shape atomically creates a cleanup tombstone
  # for the exact old object and deletes that object's task branch. Accept
  # either tuple order because Git owns the stdin ordering contract.
  CLEANUP_PAIR=0
  if is_cleanup_create "$LOCAL_REF_1" "$LOCAL_SHA_1" "$REMOTE_REF_1" "$REMOTE_SHA_1" \
    && is_cleanup_delete "$LOCAL_REF_2" "$LOCAL_SHA_2" "$REMOTE_REF_2" "$REMOTE_SHA_2" \
    && [ "$LOCAL_SHA_1" = "$REMOTE_SHA_2" ]; then
    CLEANUP_PAIR=1
  elif is_cleanup_create "$LOCAL_REF_2" "$LOCAL_SHA_2" "$REMOTE_REF_2" "$REMOTE_SHA_2" \
    && is_cleanup_delete "$LOCAL_REF_1" "$LOCAL_SHA_1" "$REMOTE_REF_1" "$REMOTE_SHA_1" \
    && [ "$LOCAL_SHA_2" = "$REMOTE_SHA_1" ]; then
    CLEANUP_PAIR=1
  fi
  [ "$CLEANUP_PAIR" -eq 1 ] \
    || fail "multiple ref updates are not a cleanup transaction"
  exec ./preflight.sh --quick --hook-format-only
fi

# Cleanup tombstones and release tags are not feature publications, but every
# push still keeps the formatting half of the mandatory quick gate.
case "$REMOTE_REF_1" in
  refs/heads/quorum-cleanup/*)
    if is_zero_oid "$LOCAL_SHA_1" && ! is_zero_oid "$REMOTE_SHA_1"; then
      exec ./preflight.sh --quick --hook-format-only
    fi
    fail "invalid cleanup ref update"
    ;;
  refs/tags/*)
    is_zero_oid "$LOCAL_SHA_1" && fail "deleted refs are not permitted"
    exec ./preflight.sh --quick --hook-format-only
    ;;
  refs/heads/*) ;;
  *) fail "remote ref must map to refs/heads/* or refs/tags/*" ;;
esac

is_zero_oid "$LOCAL_SHA_1" && fail "deleted refs are not permitted"
git cat-file -e "$LOCAL_SHA_1^{commit}" 2>/dev/null \
  || fail "local SHA is not a commit"

if is_zero_oid "$REMOTE_SHA_1"; then
  # A new branch has no already-published history to exclude.
  exec ./preflight.sh --quick --proposed-sha="$LOCAL_SHA_1"
fi

git cat-file -e "$REMOTE_SHA_1^{commit}" 2>/dev/null \
  || fail "remote SHA is not a local commit"
git merge-base --is-ancestor "$REMOTE_SHA_1" "$LOCAL_SHA_1" \
  || fail "remote branch update is stale or non-fast-forward"

exec ./preflight.sh --quick --proposed-sha="$LOCAL_SHA_1" \
  --continuation-from="$REMOTE_SHA_1"
