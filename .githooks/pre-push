#!/bin/sh
# pre-push — cheap mechanical gate on every push: branch-base check + cargo fmt.
#
# Installed by dev-install.sh via `git config core.hooksPath .githooks` (repo
# config is shared by all worktrees). The full gate — clippy + tests — is
# ./preflight.sh, required before `task-update --status done`; this hook only
# runs the fast subset so pushing stays quick while still catching the two most
# common review-round wasters: fmt drift and branching from a feature branch.
#
# Do NOT bypass with --no-verify — fix the underlying issue instead.

set -u

fail() {
  printf 'pre-push: %s\n' "$1" >&2
  exit 1
}

[ "$#" -eq 2 ] || fail "expected remote name and URL arguments"

# Git supplies one line per proposed ref update:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# Quorum publishes exactly one branch at a time. Fail closed on ambiguous input
# rather than accidentally checking HEAD while Git pushes some other object.
LOCAL_REF=
LOCAL_SHA=
REMOTE_REF=
REMOTE_SHA=
EXTRA=
if ! read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA EXTRA; then
  [ -n "$LOCAL_REF$LOCAL_SHA$REMOTE_REF$REMOTE_SHA$EXTRA" ] \
    || fail "missing pre-push ref update"
fi
[ -z "$EXTRA" ] || fail "malformed pre-push ref update"
NEXT_LINE=
if IFS= read -r NEXT_LINE || [ -n "$NEXT_LINE" ]; then
  fail "expected exactly one ref update"
fi

is_oid() {
  printf '%s\n' "$1" | grep -Eq '^([0-9a-f]{40}|[0-9a-f]{64})$'
}
is_zero_oid() {
  printf '%s\n' "$1" | grep -Eq '^(0{40}|0{64})$'
}

is_oid "$LOCAL_SHA" || fail "malformed local SHA"
is_oid "$REMOTE_SHA" || fail "malformed remote SHA"
is_zero_oid "$LOCAL_SHA" && fail "deleted refs are not permitted"
case "$REMOTE_REF" in
  refs/heads/*) ;;
  *) fail "remote ref must map to refs/heads/*" ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

HEAD_SHA=$(git rev-parse --verify HEAD) || fail "cannot resolve HEAD"
[ "$LOCAL_SHA" = "$HEAD_SHA" ] \
  || fail "local SHA does not match HEAD"
MAPPED_SHA=$(git rev-parse --verify "$LOCAL_REF^{commit}" 2>/dev/null) \
  || fail "local ref does not resolve to a commit"
[ "$MAPPED_SHA" = "$LOCAL_SHA" ] \
  || fail "local ref does not map to local SHA"

if is_zero_oid "$REMOTE_SHA"; then
  # A new branch has no already-published history to exclude.
  exec ./preflight.sh --quick
fi

git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null \
  || fail "remote SHA is not a local commit"
git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" \
  || fail "remote branch update is stale or non-fast-forward"

exec ./preflight.sh --quick --continuation-from="$REMOTE_SHA"
